---
import { getCollection } from 'astro:content';

const products = await getCollection('productos');
const productCards = await Promise.all(products.map(async (product) => ({
  ...product,
  Content: (await product.render()).Content,
})));
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Raíz y Pétalo | Floristería y herbolario</title>
    <meta name="description" content="Flores, plantas y bienestar natural para regalarte algo bonito cada día." />
  </head>
  <body>
    <header class="nav wrap">
      <a class="brand" href="#inicio"><img src="/logo-magui.png" alt="Magui" /></a>
      <nav aria-label="Navegación principal"><a href="#flores">Flores</a><a href="#herbolario">Herbolario</a><a href="#contacto">Contacto</a></nav>
      <a class="button small" href="#contacto">Haz tu pedido</a>
    </header>
    <main id="inicio">
      <section class="hero wrap"><div class="hero-copy"><p class="eyebrow">Flores · plantas · bienestar</p><h1>Un rincón natural para <em>regalar belleza.</em></h1><p class="lead">Ramos con alma, plantas que acompañan y pequeños tesoros del herbolario para cuidar de ti y de los tuyos.</p><div class="actions"><a class="button" href="#flores">Descubre la tienda <span>→</span></a><a class="text-link" href="#contacto">Cuéntanos qué necesitas</a></div></div><div class="hero-art" aria-label="Ilustración decorativa de flores y plantas"><div class="sun"></div><div class="leaf leaf-one">🌿</div><div class="flower">🌸</div><div class="leaf leaf-two">🌱</div><div class="art-card"><strong>Hecho a mano</strong><br />con calma y cariño</div></div></section>
      <section class="intro wrap" id="flores"><div><p class="eyebrow">Lo que encontrarás</p><h2>Naturalmente bonito.</h2></div><p>Seleccionamos cada flor, planta e infusión pensando en crear momentos especiales. Pasa a visitarnos o escríbenos y te ayudamos a elegir.</p></section>
      <section class="cards wrap" id="herbolario">{productCards.map((product) => <article class="card"><div class="icon">🌷</div><h3>{product.data.nombre}</h3><div class="description"><product.Content /></div><a href="#contacto">Consultar <span>↗</span></a></article>)}</section>
      <section class="quote wrap"><p>“Las flores no solo decoran: cuentan lo que a veces no sabemos decir.”</p><span>— Raíz y Pétalo</span></section>
      <section class="contact wrap" id="contacto"><div><p class="eyebrow">¿Hablamos?</p><h2>Te ayudamos a encontrar<br /><em>algo especial.</em></h2></div><div><p>Pedidos personalizados, regalos y recomendaciones naturales. Escríbenos sin compromiso.</p><a class="button" href="mailto:hola@raizypetalo.es">Escribir por email <span>→</span></a></div></section>
    </main>
    <footer class="footer wrap"><span>✿ Raíz y Pétalo</span><span>Floristería y herbolario</span><span>© 2026</span></footer>
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;color:#173d35;background:#fff8ed;font-family:Georgia,'Times New Roman',serif}:global(a){color:inherit;text-decoration:none}.wrap{width:min(1120px,calc(100% - 48px));margin-inline:auto}.nav{position:relative;z-index:0;height:82px;display:flex;align-items:center;justify-content:space-between;gap:24px;color:#a6cf38}.nav:before,.footer:before{content:'';position:absolute;z-index:-1;top:0;bottom:0;left:50%;width:100vw;transform:translateX(-50%);background:#050505}.brand{display:flex;align-items:center}.brand img{display:block;width:156px;height:auto;max-height:62px;object-fit:contain}nav{display:flex;gap:28px;color:#a6cf38;font:500 .9rem Arial,sans-serif}nav a:hover,.text-link:hover{color:#ef5b4d}.button{display:inline-flex;gap:14px;align-items:center;background:#07856f;color:#fff;padding:15px 21px;border-radius:999px;font:700 .86rem Arial,sans-serif}.button:hover{background:#ef5b4d}.button.small{padding:11px 16px;font-size:.78rem}.hero{min-height:580px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:40px}.eyebrow{color:#ef5b4d;text-transform:uppercase;letter-spacing:.18em;font:700 .72rem Arial,sans-serif}.hero h1{max-width:620px;margin:18px 0;font-size:clamp(3rem,6vw,5.4rem);font-weight:400;line-height:.98}.hero h1 em,h2 em{color:#ef5b4d;font-style:italic}.lead{max-width:460px;color:#477568;font:1.05rem/1.7 Arial,sans-serif}.actions{display:flex;gap:24px;align-items:center;margin-top:30px}.text-link{font:700 .82rem Arial,sans-serif;border-bottom:1px solid #81bbaa;padding-bottom:4px}.hero-art{position:relative;height:430px;overflow:hidden;border-radius:48% 48% 12px 12px;background:#b9e7cf}.sun{position:absolute;width:210px;height:210px;border-radius:50%;background:#ffd166;top:58px;left:25%}.flower{position:absolute;font-size:7.5rem;top:125px;left:32%;transform:rotate(-8deg)}.leaf{position:absolute;font-size:6rem}.leaf-one{bottom:48px;left:15%;transform:rotate(-35deg)}.leaf-two{bottom:35px;right:14%;transform:rotate(35deg)}.art-card{position:absolute;right:22px;bottom:22px;padding:16px 20px;background:#fff8ed;border-radius:4px;color:#28705d;font:.82rem/1.5 Arial,sans-serif}.art-card strong{color:#07856f}.intro{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end;padding:72px 0 34px;border-top:1px solid #b9dfcd}.intro h2,.contact h2{margin:12px 0 0;font-size:clamp(2.2rem,4vw,3.6rem);font-weight:400;line-height:1.05}.intro>p,.contact>div:last-child>p{margin:0;color:#477568;font:1rem/1.7 Arial,sans-serif}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding:28px 0 90px}.card{padding:30px;background:#fff;border:1px solid #d4efe1;border-radius:8px}.icon{font-size:2.2rem}.card h3{margin:22px 0 8px;font-size:1.45rem;font-weight:400}.card p{min-height:72px;color:#5c8175;font:.9rem/1.6 Arial,sans-serif}.card a{color:#ef5b4d;font:700 .8rem Arial,sans-serif}.quote{padding:66px 20px;text-align:center;background:#d9f2df}.quote p{margin:0 auto 14px;max-width:650px;font-size:clamp(1.7rem,3vw,2.5rem);font-style:italic}.quote span{color:#478071;font:.78rem Arial,sans-serif}.contact{display:grid;grid-template-columns:1fr 1fr;gap:50px;padding:100px 0}.contact .button{margin-top:24px}.footer{position:relative;z-index:0;display:flex;justify-content:space-between;padding:24px 0 34px;border-top:1px solid #355c45;color:#a6cf38;font:.75rem Arial,sans-serif}@media(max-width:700px){.wrap{width:min(100% - 32px,560px)}.nav nav,.nav .button{display:none}.hero,.intro,.contact{grid-template-columns:1fr}.hero{padding:58px 0}.hero-art{height:330px}.cards{grid-template-columns:1fr;padding-bottom:55px}.card p{min-height:auto}.footer{gap:10px;flex-wrap:wrap}}
</style>
